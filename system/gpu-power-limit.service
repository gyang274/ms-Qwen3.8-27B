[Unit]
Description=Set NVIDIA GPU power limit (250 W, see /dd/neuron/README.md)
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nvidia-smi -pl 250
ExecStop=/usr/bin/nvidia-smi -pl 300

[Install]
WantedBy=multi-user.target
